# Modo demostración: corre con un Postgres en memoria, sin base externa,
# y el login acepta cualquier credencial. Para enseñar la plataforma.
# Excluyente: si está en 1, DATABASE_URL se ignora por completo.
DEMO_MODE=0

# Supabase → Project Settings → Database → Connection string → Transaction pooler
# Usa el puerto 6543 (pooler), NO el 5432: desde funciones serverless una
# conexión directa agota el pool de Postgres en cuanto Vercel escala.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Contraseña del usuario admin que crea `npm run migrate`.
# Si la omites usa 'admin123' — cámbiala antes de exponer el panel.
ADMIN_EMAIL=tu@correo.com
ADMIN_PASSWORD=

# Opcional: siembra datos de demostración al migrar (1 = sí)
SEED_DEMO=0
