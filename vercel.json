{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": "public/index.html"
    }
  },
  "crons": [
    {
      "path": "/api/despacho/pendientes",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/inversion/sincronizar",
      "schedule": "*/30 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/t/:code",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}