{
  "name": "dropstudio",
  "version": "1.0.0",
  "private": true,
  "description": "DropStudio — plataforma de testeo de productos (landings, pedidos COD, analítica).",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env server/index.js",
    "dev": "node --no-warnings --env-file-if-exists=.env --watch server/index.js",
    "migrate": "node --no-warnings --env-file-if-exists=.env server/migrate.js"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
